{
  "name": "slapulse",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "migrate": "dotenv -e .env -- node-pg-migrate up -j js",
    "migrate:down": "dotenv -e .env -- node-pg-migrate down -j js",
    "seed": "tsx scripts/seed.ts",
    "worker": "tsx watch src/worker.ts"
  },
  "dependencies": {
    "@aws-sdk/client-ecs": "^3.1102.0",
    "@aws-sdk/client-elastic-load-balancing-v2": "^3.1102.0",
    "@aws-sdk/client-route-53": "^3.1102.0",
    "@aws-sdk/client-sts": "^3.1102.0",
    "dotenv": "^17.4.2",
    "lucide-react": "^1.27.0",
    "next": "16.2.11",
    "node-cron": "^4.6.0",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.22.0",
    "puppeteer": "^25.3.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^2.15.4",
    "uuid": "^14.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/uuid": "^10.0.0",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5"
  }
}
